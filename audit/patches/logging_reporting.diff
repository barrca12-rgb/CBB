new file mode 100644
index 0000000..6ef9d52
--- /dev/null
+++ b/.github/workflows/quotes.yml
@@ -0,0 +1,39 @@
+# Targeted quote polling for the forward-test execution check (FORWARD_TEST_PROTOCOL.md, section 5).
+# Dispatched every 3 minutes by a cron-job.org job (same token as the card job). Each run makes at most one Odds API
+# call (2 credits) and only when a game is inside a watch window; otherwise it records a skipped poll. It never
+# touches the model, the card, the bet log, openers.csv or closing.csv.
+name: Targeted quote poll
+
+on:
+  workflow_dispatch:
+
+permissions:
+  contents: write
+
+concurrency:
+  group: targeted-quote-poll
+  cancel-in-progress: false
+
+jobs:
+  poll:
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.11"
+          cache: pip
+          cache-dependency-path: requirements.txt
+      - run: pip install -r requirements.txt
+      - name: Poll watched games
+        env:
+          ODDS_API_KEY: ${{ secrets.ODDS_API_KEY }}
+        run: python -m cbb.poll_targets
+      - name: Save the log
+        run: |
+          git config user.name "github-actions[bot]"
+          git config user.email "41898+github-actions[bot]@users.noreply.github.com"
+          git add lines/polls_targeted.csv lines/obs_targeted 2>/dev/null || true
+          git diff --cached --quiet || git commit -m "Quote poll ($(date -u +'%Y-%m-%d %H:%M') UTC)"
+          for i in 1 2 3; do git pull --rebase -X theirs origin "${{ github.ref_name }}" && git push origin "HEAD:${{ github.ref_name }}" && break; sleep 5; done
